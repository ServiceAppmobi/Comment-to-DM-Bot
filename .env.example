# ==============================================================================
# ServiceApp — Bot Comment-to-DM (Instagram & Facebook)
# ==============================================================================

# Branding i linki używane w szablonach wiadomości (rules.json)
APP_NAME=ServiceApp
APP_URL=https://serviceapp.mobi
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.serviceapp.mobile
IOS_STORE_URL=https://apps.apple.com/pl/app/serviceapp/id0000000000

# ------------------------------------------------------------------------------
# META GRAPH API (Instagram + Facebook)
# ------------------------------------------------------------------------------
META_GRAPH_API_VERSION=v21.0

# Długoterminowy Page Access Token / System User Token z uprawnieniami:
# IG: instagram_basic, instagram_manage_comments, instagram_manage_messages
# FB: pages_show_list, pages_read_engagement, pages_manage_metadata, pages_messaging
META_ACCESS_TOKEN=

# Opcjonalny osobny token dla Facebook Page (jeśli inny niż META_ACCESS_TOKEN)
FB_PAGE_ACCESS_TOKEN=

# ID konta profesjonalnego Instagram (Instagram Business / Creator Account ID)
IG_USER_ID=
# Nazwa użytkownika Instagram (bez @) — używana do filtrowania własnych komentarzy
IG_USERNAME=

# ID strony na Facebooku (Facebook Page ID)
FB_PAGE_ID=

# Włącz/wyłącz poszczególne platformy (true/false)
INSTAGRAM_ENABLED=true
FACEBOOK_ENABLED=true

# ------------------------------------------------------------------------------
# LIMITY I BEZPIECZEŃSTWO (Anty-spam & Meta 7-day Private Reply Window)
# ------------------------------------------------------------------------------
# Maksymalna liczba ostatnich postów/rolek skanowanych na platformę w jednym cyklu
MAX_POSTS_PER_PLATFORM=10
# Maksymalna liczba komentarzy pobieranych z jednego posta
MAX_COMMENTS_PER_POST=50
# Maksymalna liczba wysłanych DM w jednym uruchomieniu (ochrona przed rate-limitem)
MAX_DMS_PER_RUN=25
# Opóźnienie między kolejnymi wysyłkami DM (w sekundach)
REPLY_DELAY_SECONDS=1.5
# Okno czasowe komentarza w dniach (Meta pozwala na Private Reply do 7 dni; zalecane 6)
MAX_COMMENT_AGE_DAYS=6
# Tryb symulacji (true = nie wysyła prawdziwych DM ani komentarzy do Meta)
DRY_RUN=false

# ------------------------------------------------------------------------------
# OPCJONALNY SERWER WEBHOOK (tylko jeśli uruchamiasz --webhook-server na VPS)
# ------------------------------------------------------------------------------
META_VERIFY_TOKEN=serviceapp_comment_dm_verify_token
META_APP_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8089

# ------------------------------------------------------------------------------
# OPCJONALNA PERSONALIZACJA AI (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# POWIADOMIENIA I RAPORTY NA IPHONE (tak jak w ServiceApp LatAm Bot)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_RECIPIENT=karolak.pawel@gmail.com
EMAIL_SENDER=onboarding@resend.dev

# Fallback SMTP (opcjonalnie)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Push na iPhone (ntfy / Telegram)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
